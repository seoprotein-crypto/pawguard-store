{%- comment -%} PawGuard — tabbed FAQ (Product / Shipping / Orders & payment) {%- endcomment -%}
{%- assign t1 = section.settings.tab_1 -%}{%- assign t2 = section.settings.tab_2 -%}{%- assign t3 = section.settings.tab_3 -%}
<section class="pg pg-faq pg-bg-grey">
  <div class="pg-wrap pg-narrow pg-center">
    <h2 class="pg-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="pg-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    <div data-tabs>
      <div class="pg-pills" role="tablist">
        <button type="button" role="tab" class="pg-pilltab is-active" data-tab="1" aria-selected="true">{{ t1 }}</button>
        <button type="button" role="tab" class="pg-pilltab" data-tab="2" aria-selected="false">{{ t2 }}</button>
        <button type="button" role="tab" class="pg-pilltab" data-tab="3" aria-selected="false">{{ t3 }}</button>
      </div>
      {%- for n in (1..3) -%}
        {%- assign key = n | append: '' -%}
        <div class="pg-tabs__panel{% if n == 1 %} is-active{% endif %}" data-panel="{{ n }}" role="tabpanel" {% unless n == 1 %}hidden{% endunless %}>
          {%- for block in section.blocks -%}
            {%- if block.settings.tab == key -%}
              <details class="pg-acc pg-acc--card" {{ block.shopify_attributes }} {% if forloop.first and n == 1 %}open{% endif %}>
                <summary>{{ block.settings.question }}</summary>
                <div class="pg-acc__body">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{{ 'pawguard.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pawguard.js' | asset_url }}" defer></script>
{%- comment -%} FAQ structured data for Google {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{% schema %}
{
  "name": "PawGuard FAQ tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Everything you need to know" },
    { "type": "text", "id": "tab_1", "label": "Tab 1", "default": "Product" },
    { "type": "text", "id": "tab_2", "label": "Tab 2", "default": "Shipping" },
    { "type": "text", "id": "tab_3", "label": "Tab 3", "default": "Orders & payment" }
  ],
  "blocks": [
    { "type": "q", "name": "Question", "settings": [
      { "type": "select", "id": "tab", "label": "Tab", "default": "1", "options": [ { "value": "1", "label": "Tab 1" }, { "value": "2", "label": "Tab 2" }, { "value": "3", "label": "Tab 3" } ] },
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" } ] }
  ],
  "presets": [{ "name": "PawGuard FAQ tabs" }]
}
{% endschema %}
