{%- comment -%} PawGuard home — "root cause" proof card with stats and photo. Stats must be real. {%- endcomment -%}
<section class="pgh">
  <div class="pgh-wrap">
    <div class="pgh-proof">
      <div class="pgh-proof__b">
        <h2 class="pgh-h2">{{ section.settings.heading }}</h2>
        <p class="pgh-text">{{ section.settings.text }}</p>
        <div class="pgh-stats">
          {%- for block in section.blocks -%}
            <div class="pgh-stat" {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></div>
          {%- endfor -%}
        </div>
      </div>
      <div class="pgh-proof__img">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: class: 'pgh-img', loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 990px) 50vw, 100vw' }}
        {%- else -%}{{ 'image' | placeholder_svg_tag: 'pgh-img' }}{%- endif -%}
      </div>
    </div>
  </div>
</section>
{{ 'pawguard-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{
  "name": "PawGuard proof card",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the root cause, not just the symptoms." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat (real numbers only)", "limit": 4, "settings": [
      { "type": "text", "id": "value", "label": "Number" },
      { "type": "text", "id": "label", "label": "Label" } ] }
  ],
  "presets": [{ "name": "PawGuard proof card" }]
}
{% endschema %}
