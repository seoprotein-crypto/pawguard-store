{%- comment -%} PawGuard home — Gut Check teaser with a mini "pick up to 3" card that pre-fills the quiz. {%- endcomment -%}
{%- assign quiz_url = section.settings.link | default: '/pages/gut-check' -%}
<section class="pgh">
  <div class="pgh-wrap">
    <div class="pgh-qz">
      <div class="pgh-qz__b">
        <h2 class="pgh-h2">{{ section.settings.heading }}</h2>
        <p class="pgh-text">{{ section.settings.text }}</p>
        <div class="pgh-btns"><a class="pgh-btn pgh-btn--green" href="{{ quiz_url }}">{{ section.settings.btn_label }} <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="pgh-qz__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: class: 'pgh-img', loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 990px) 50vw, 100vw', style: 'position:absolute;inset:0' }}
        {%- else -%}{{ 'image' | placeholder_svg_tag: 'pgh-img' }}{%- endif -%}
        <div class="pgh-qz__card" data-pgh-qz>
          <p class="pgh-qz__q">{{ section.settings.card_q }}</p>
          <p class="pgh-qz__sub">Choose up to 3</p>
          {%- for block in section.blocks -%}
            <button type="button" class="pgh-qz__opt" data-qz-opt="{{ block.settings.concern }}" aria-pressed="false" {{ block.shopify_attributes }}><i aria-hidden="true"></i>{{ block.settings.label }}</button>
          {%- endfor -%}
          <a class="pgh-btn pgh-btn--green pgh-qz__go" data-qz-go href="{{ quiz_url }}">Continue</a>
        </div>
      </div>
    </div>
  </div>
</section>
{{ 'pawguard-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pawguard-home.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "PawGuard quiz teaser",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure where to start?" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Take the Gut Check" },
    { "type": "url", "id": "link", "label": "Quiz link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "card_q", "label": "Card question", "default": "What would you most like to help your dog with?" }
  ],
  "blocks": [
    { "type": "option", "name": "Quiz option", "limit": 4, "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "select", "id": "concern", "label": "Quiz answer it selects", "default": "scoot", "options": [
        { "value": "scoot", "label": "Scooting / worms / grass" }, { "value": "itch", "label": "Itching / licking" },
        { "value": "tummy", "label": "Tummy trouble" }, { "value": "coat", "label": "Coat / shedding" },
        { "value": "energy", "label": "Energy / sleep" }, { "value": "wellness", "label": "General health" } ] } ] }
  ],
  "presets": [{ "name": "PawGuard quiz teaser" }]
}
{% endschema %}
