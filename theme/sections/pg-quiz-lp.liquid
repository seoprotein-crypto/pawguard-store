{%- comment -%}
  PawGuard quiz funnel landing page (used by page.quiz-reactivity / page.quiz-signs).
  Full-screen panels: hero -> story panels -> checklist -> compare -> vet -> reviews -> 2 quiz questions -> product.
  "Continue" scrolls to the next panel, "Skip" jumps to the first question. Final answers go to the product page.
{%- endcomment -%}
{%- liquid
  assign p = section.settings.product
  assign product_url = p.url | default: '/products/parasite-cleanse-drops'
  assign sid = section.id
-%}
<style>
  .pgq{--g:#1f5c3f;--gd:#173f2d;--gs:#e7efe9;--paper:#f3ece0;--paper2:#f8f4ec;--ink:#1d2b24;--mut:#5d6b64;--line:#e3e8e5;--gold:#e0a526;color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;background:#fff}
  .pgq *{box-sizing:border-box}
  .pgq-top{position:sticky;top:0;z-index:40;background:#fff;border-bottom:1px solid var(--line);text-align:center;padding:12px 16px}
  .pgq-top img{display:inline-block;height:auto;vertical-align:middle}
  .pgq-panel{min-height:calc(100svh - 58px);display:flex;align-items:center;padding:64px 20px;scroll-margin-top:58px}
  .pgq-panel--paper{background:var(--paper)}
  .pgq-panel--paper2{background:var(--paper2)}
  .pgq-in{max-width:1100px;margin:0 auto;width:100%}
  .pgq-two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:center}
  .pgq-two--rev .pgq-media{order:-1}
  .pgq-narrow{max-width:620px;margin:0 auto;text-align:center}
  .pgq h1{font-size:clamp(30px,3.6vw,46px);line-height:1.12;font-weight:900;letter-spacing:-.02em;margin:0 0 18px}
  .pgq h2{font-size:clamp(26px,2.8vw,36px);line-height:1.15;font-weight:900;letter-spacing:-.02em;margin:0 0 16px}
  .pgq h1 em,.pgq h2 em{font-style:normal;color:var(--g)}
  .pgq-eyebrow{display:flex;align-items:center;gap:10px;color:var(--g);font-weight:800;font-size:13px;letter-spacing:.1em;text-transform:uppercase;margin:0 0 14px}
  .pgq-eyebrow:before{content:"";width:22px;height:2px;background:var(--g)}
  .pgq-text{color:#3d4a43;font-size:17px}
  .pgq-text p{margin:0 0 14px}
  .pgq-text ol,.pgq-text ul{padding-left:20px;margin:0 0 14px}
  .pgq-text li{margin-bottom:8px}
  .pgq-guar{font-weight:800;color:#3d4a43;margin:6px 0 0}
  .pgq-rating{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--mut);font-weight:600;margin-top:18px}
  .pgq-stars{color:var(--g);letter-spacing:2px}
  .pgq-btns{display:flex;gap:14px;flex-wrap:wrap;margin-top:24px}
  .pgq-narrow .pgq-btns{justify-content:center}
  .pgq-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;padding:12px 30px;border-radius:999px;border:0;font:inherit;font-weight:800;font-size:16px;cursor:pointer;text-decoration:none;transition:transform .12s,background .15s}
  .pgq-btn:active{transform:scale(.98)}
  .pgq-btn--go{background:var(--g);color:#fff;box-shadow:0 6px 16px rgba(31,92,63,.25)}
  .pgq-btn--go:hover{background:var(--gd)}
  .pgq-btn--go:after{content:"›";font-size:20px;line-height:1}
  .pgq-btn--skip{background:var(--gs);color:var(--gd)}
  .pgq-btn--skip:hover{background:#d7e6dc}
  .pgq-media{position:relative}
  .pgq-media img{display:block;width:100%;height:auto;border-radius:20px;box-shadow:0 14px 34px rgba(0,0,0,.08)}
  .pgq-ph{border:2px dashed #c9b99f;background:#fbf7f0;color:#8a7550;border-radius:20px;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;text-align:center;padding:20px;font-weight:700;font-size:14px}
  .pgq-hero{padding:0;min-height:calc(100svh - 58px);align-items:stretch}
  .pgq-hero .pgq-two{max-width:none;gap:0;min-height:inherit;align-items:stretch}
  .pgq-hero .pgq-media img{height:100%;object-fit:cover;border-radius:0;box-shadow:none}
  .pgq-hero .pgq-media .pgq-ph{height:100%;aspect-ratio:auto;border-radius:0}
  .pgq-hero__b{display:flex;flex-direction:column;justify-content:center;padding:56px 64px;background:var(--paper2)}
  .pgq-check{list-style:none;padding:0;margin:0 0 16px}
  .pgq-check li{display:flex;gap:12px;align-items:flex-start;padding:7px 0;font-weight:600;font-size:15.5px}
  .pgq-check li:before{content:"✓";flex:0 0 22px;height:22px;border-radius:50%;background:var(--g);color:#fff;font-size:13px;display:flex;align-items:center;justify-content:center;margin-top:1px}
  .pgq-tag{display:inline-block;margin-left:6px;font-size:11px;font-weight:800;color:var(--g);background:var(--gs);border-radius:999px;padding:1px 8px;vertical-align:middle}
  .pgq-compare p{margin:0 0 12px;color:#3d4a43;font-size:17px}
  .pgq-box{background:var(--gs);border-radius:16px;padding:18px 22px;margin:22px auto 8px;text-align:left;max-width:560px}
  .pgq-box ul{list-style:none;margin:0;padding:0}
  .pgq-box li{position:relative;padding-left:24px;margin:6px 0;font-weight:700;font-size:15px}
  .pgq-box li:before{content:"✓";position:absolute;left:0;color:var(--g);font-weight:900}
  .pgq-fine{font-size:12px;color:var(--mut);font-style:italic;margin-top:10px}
  .pgq-vets{display:grid;gap:16px;margin:8px 0 6px;text-align:left}
  .pgq-vet{background:var(--g);color:#fff;border-radius:18px;padding:22px;display:grid;grid-template-columns:minmax(0,1fr) 72px;gap:18px;align-items:center;position:relative}
  .pgq-vet:after{content:"";position:absolute;left:28px;bottom:-10px;border:10px solid transparent;border-bottom:0;border-top-color:var(--g)}
  .pgq-vet q{display:block;font-size:15px;line-height:1.55;quotes:"“" "”"}
  .pgq-vet b{display:block;margin-top:12px}
  .pgq-vet small{opacity:.85}
  .pgq-vet__img{width:72px;height:72px;border-radius:50%;border:3px solid #fff;overflow:hidden;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:11px;text-align:center;font-weight:700}
  .pgq-vet__img img{width:100%;height:100%;object-fit:cover}
  .pgq-empty{background:rgba(255,255,255,.18);border:1px dashed rgba(255,255,255,.7);border-radius:6px;padding:1px 6px}
  .pgq-rv-wrap{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:40px;align-items:start}
  .pgq-rv-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .pgq-rv{background:#fff;border-radius:14px;padding:16px;box-shadow:0 2px 10px rgba(0,0,0,.05)}
  .pgq-rv img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:10px;display:block;margin-bottom:10px}
  .pgq-rv .pgq-stars{color:var(--gold);font-size:14px}
  .pgq-rv h3{font-size:15px;margin:6px 0;line-height:1.3}
  .pgq-rv p{font-size:14px;color:#4b5852;margin:0 0 8px}
  .pgq-rv small{font-weight:700;color:var(--ink)}
  .pgq-badge{display:inline-flex;gap:8px;align-items:center;background:var(--g);color:#fff;border-radius:8px;padding:8px 14px;font-weight:800;font-size:14px;margin-bottom:16px}
  .pgq-photos{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
  .pgq-photos img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:12px;display:block}
  .pgq-q{text-align:center}
  .pgq-q h2{max-width:560px;margin:0 auto 22px}
  .pgq-opts{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;max-width:560px;margin:0 auto}
  .pgq-opt{background:var(--g);color:#fff;border:0;border-radius:999px;min-height:52px;padding:12px 26px;font:inherit;font-weight:800;font-size:16px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}
  .pgq-opt:hover,.pgq-opt[aria-pressed=true]{background:var(--gd)}
  .pgq-qnote{max-width:520px;margin:20px auto 0;font-size:14px;color:var(--mut)}
  .pgq-foot{background:var(--gd);color:rgba(255,255,255,.78);text-align:center;font-size:12px;line-height:1.6;padding:36px 20px 110px}
  .pgq-foot strong{display:block;color:#fff;font-size:14px;margin-bottom:12px;text-transform:uppercase;letter-spacing:.03em}
  .pgq-foot p{max-width:820px;margin:0 auto 10px}
  .pgq-foot nav{margin-top:16px}
  .pgq-foot a{color:#fff;margin:0 8px}
  .pgq-sticky{display:none}
  @media (max-width:989px){
    .pgq-panel{min-height:0;padding:40px 20px}
    .pgq-two,.pgq-rv-wrap{grid-template-columns:minmax(0,1fr);gap:24px}
    .pgq-two--rev .pgq-media,.pgq-two .pgq-media{order:-1}
    .pgq-hero{min-height:0}
    .pgq-hero .pgq-media img{height:auto;aspect-ratio:4/3}
    .pgq-hero .pgq-media .pgq-ph{aspect-ratio:4/3}
    .pgq-hero__b{padding:28px 20px 34px}
    .pgq-panel:not(.pgq-hero):not(.pgq-qpanel) .pgq-btns{display:none}
    .pgq-q-panel{min-height:70svh}
    .pgq-sticky{position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;gap:10px;padding:10px 16px calc(12px + env(safe-area-inset-bottom));background:linear-gradient(to top,rgba(255,255,255,.98) 70%,rgba(255,255,255,0));transition:transform .2s}
    .pgq-sticky[hidden]{display:none}
    .pgq-sticky .pgq-btn{flex:1;padding:12px 16px}
    .pgq-sticky .pgq-btn--skip{flex:0 0 auto}
    .pgq-rv-grid{grid-template-columns:minmax(0,1fr)}
    .pgq-vet{grid-template-columns:minmax(0,1fr) 60px}
    .pgq-vet__img{width:60px;height:60px}
  }
  /* reviews fold: tidy 2x2 cards + square 3x3 photo grid */
  .pgq-rv-wrap{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;align-items:stretch}
  .pgq-rv-col{display:flex;flex-direction:column}
  .pgq-rv-wrap h2{font-size:clamp(22px,2.2vw,28px);line-height:1.2;margin:0 0 18px}
  .pgq-rv-grid{flex:1;grid-auto-rows:1fr}
  .pgq-rv{display:flex;flex-direction:column;padding:20px;border:1px solid #ece4d6}
  .pgq-rv p{flex:1;font-size:14px;line-height:1.6}
  .pgq-rv .pgq-stars{margin-bottom:6px}
  .pgq-photos{grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));aspect-ratio:1/1;gap:10px}
  .pgq-photos{min-height:0;height:auto;align-self:start;width:100%}
  .pgq-photos img{width:100%;height:100%;min-height:0;aspect-ratio:auto;object-fit:cover;overflow:hidden}
  .pgq-cmp-img{max-width:520px;margin:18px auto 20px}
  .pgq-cmp-img img{display:block;width:100%;height:auto;border-radius:18px;box-shadow:0 14px 34px rgba(0,0,0,.08)}
  @media (max-width:989px){
    .pgq-rv-wrap{grid-template-columns:minmax(0,1fr)}
    .pgq-rv-grid{grid-template-columns:minmax(0,1fr);grid-auto-rows:auto}
  }
</style>

{%- capture skip_target -%}#pgq-q1-{{ sid }}{%- endcapture -%}

<div class="pgq" data-pgq id="pgq-{{ sid }}">
  <header class="pgq-top">
    <a href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}{{ section.settings.logo | image_url: width: 300 | image_tag: width: 140, alt: shop.name }}{%- else -%}<strong>{{ shop.name }}</strong>{%- endif -%}
    </a>
  </header>

  {%- assign q_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign bg = 'pgq-panel--paper'
      if b.bg == 'white'
        assign bg = ''
      elsif b.bg == 'paper2'
        assign bg = 'pgq-panel--paper2'
      endif
      assign show_skip = b.show_skip
    -%}
    {%- capture media -%}
      {%- if b.image != blank -%}
        {{ b.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', alt: b.image.alt }}
      {%- else -%}
        <div class="pgq-ph">[IMAGE{% if b.image_hint != blank %} — {{ b.image_hint }}{% endif %}]</div>
      {%- endif -%}
    {%- endcapture -%}
    {%- capture buttons -%}
      <div class="pgq-btns">
        <button type="button" class="pgq-btn pgq-btn--go" data-pgq-next>{{ b.btn | default: 'Continue' }}</button>
        {%- if show_skip -%}<button type="button" class="pgq-btn pgq-btn--skip" data-pgq-skip>Skip</button>{%- endif -%}
      </div>
    {%- endcapture -%}

    {%- case block.type -%}
      {%- when 'hero' -%}
        <section class="pgq-panel pgq-hero" data-pgq-panel data-btn="{{ b.btn | escape }}" data-skip="{{ show_skip }}" {{ block.shopify_attributes }}>
          <div class="pgq-two">
            <div class="pgq-media">
              {%- if b.image != blank -%}
                <picture>
                  {%- if b.image_mobile != blank -%}<source media="(max-width: 989px)" srcset="{{ b.image_mobile | image_url: width: 900 }}">{%- endif -%}
                  {{ b.image | image_url: width: 1600 | image_tag: fetchpriority: 'high', alt: b.image.alt }}
                </picture>
              {%- else -%}<div class="pgq-ph">[IMAGE — hero photo]</div>{%- endif -%}
            </div>
            <div class="pgq-hero__b">
              {%- if b.eyebrow != blank -%}<p class="pgq-eyebrow">{{ b.eyebrow }}</p>{%- endif -%}
              <h1>{{ b.heading }}{% if b.heading_hl != blank %} <em>{{ b.heading_hl }}</em>{% endif %}{{ b.heading_end }}</h1>
              <div class="pgq-text">{{ b.text }}</div>
              {%- if b.guarantee != blank -%}<p class="pgq-guar">{{ b.guarantee }}</p>{%- endif -%}
              {{ buttons }}
              {%- if b.rating != blank -%}<div class="pgq-rating"><span class="pgq-stars">★★★★½</span>{{ b.rating }}</div>{%- endif -%}
            </div>
          </div>
        </section>

      {%- when 'panel' -%}
        <section class="pgq-panel {{ bg }}" data-pgq-panel data-btn="{{ b.btn | escape }}" data-skip="{{ show_skip }}" {{ block.shopify_attributes }}>
          <div class="pgq-in pgq-two{% if b.image_left %} pgq-two--rev{% endif %}">
            <div>
              <h2>{{ b.heading }}</h2>
              <div class="pgq-text">{{ b.text }}</div>
              {{ buttons }}
            </div>
            <div class="pgq-media">{{ media }}</div>
          </div>
        </section>

      {%- when 'checklist' -%}
        <section class="pgq-panel {{ bg }}" data-pgq-panel data-btn="{{ b.btn | escape }}" data-skip="{{ show_skip }}" {{ block.shopify_attributes }}>
          <div class="pgq-in pgq-two">
            <div>
              <h2>{{ b.heading }}</h2>
              {%- if b.intro != blank -%}<div class="pgq-text"><p>{{ b.intro }}</p></div>{%- endif -%}
              <ul class="pgq-check">
                {%- assign items = b.items | newline_to_br | split: '<br />' -%}
                {%- assign n = 0 -%}
                {%- for it in items -%}{%- assign t = it | strip -%}{%- if t != blank -%}{%- assign n = n | plus: 1 -%}<li><span>{{ t }}{% if n == 1 and b.first_tag != blank %}<span class="pgq-tag">{{ b.first_tag }}</span>{% endif %}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
              {%- if b.outro != blank -%}<div class="pgq-text"><p>{{ b.outro }}</p></div>{%- endif -%}
              {{ buttons }}
            </div>
            <div class="pgq-media">{{ media }}</div>
          </div>
        </section>

      {%- when 'compare' -%}
        <section class="pgq-panel {{ bg }}" data-pgq-panel data-btn="{{ b.btn | escape }}" data-skip="{{ show_skip }}" {{ block.shopify_attributes }}>
          <div class="pgq-in pgq-narrow pgq-compare">
            <h2>{{ b.heading }}{% if b.heading_2 != blank %}<br><em>{{ b.heading_2 }}</em>{% endif %}</h2>
            {%- if b.image != blank -%}<div class="pgq-cmp-img">{{ b.image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: b.image.alt }}</div>{%- elsif b.image_hint != blank -%}<div class="pgq-cmp-img"><div class="pgq-ph">[IMAGE — {{ b.image_hint }}]</div></div>{%- endif -%}
            <div class="pgq-text">{{ b.text }}</div>
            {%- if b.points != blank -%}
              <div class="pgq-box"><ul>
                {%- assign pts = b.points | newline_to_br | split: '<br />' -%}
                {%- for pt in pts -%}{%- assign t = pt | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
              </ul></div>
            {%- endif -%}
            {%- if b.fine != blank -%}<p class="pgq-fine">{{ b.fine }}</p>{%- endif -%}
            {{ buttons }}
          </div>
        </section>

      {%- when 'vet' -%}
        <section class="pgq-panel {{ bg }}" data-pgq-panel data-btn="{{ b.btn | escape }}" data-skip="{{ show_skip }}" {{ block.shopify_attributes }}>
          <div class="pgq-in pgq-narrow">
            <h2>{{ b.heading }}</h2>
            <div class="pgq-vets">
              {%- for i in (1..2) -%}
                {%- liquid
                  assign kq = 'vet' | append: i | append: '_quote'
                  assign kn = 'vet' | append: i | append: '_name'
                  assign kt = 'vet' | append: i | append: '_title'
                  assign ki = 'vet' | append: i | append: '_image'
                  assign vq = b[kq]
                  assign vn = b[kn]
                  assign vt = b[kt]
                  assign vi = b[ki]
                -%}
                {%- if i == 1 or vq != blank or vn != blank -%}
                  <div class="pgq-vet">
                    <div>
                      <q>{%- if vq != blank -%}{{ vq }}{%- else -%}<span class="pgq-empty">[Your vet’s testimonial, in her own words]</span>{%- endif -%}</q>
                      <b>{%- if vn != blank -%}{{ vn }}{%- else -%}<span class="pgq-empty">[Vet name], DVM</span>{%- endif -%}</b>
                      <small>{%- if vt != blank -%}{{ vt }}{%- else -%}<span class="pgq-empty">[Title · years of practice]</span>{%- endif -%}</small>
                    </div>
                    <div class="pgq-vet__img">{%- if vi != blank -%}{{ vi | image_url: width: 160 | image_tag: alt: vn }}{%- else -%}Photo{%- endif -%}</div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if b.disclosure != blank -%}<p class="pgq-fine">{{ b.disclosure }}</p>{%- endif -%}
            {{ buttons }}
          </div>
        </section>

      {%- when 'reviews' -%}
        <section class="pgq-panel {{ bg }}" data-pgq-panel data-btn="{{ b.btn | escape }}" data-skip="{{ show_skip }}" {{ block.shopify_attributes }}>
          <div class="pgq-in">
            <div class="pgq-rv-wrap">
              <div class="pgq-rv-col">
                <h2>{{ b.heading }}</h2>
                <div class="pgq-rv-grid">
                  {%- for i in (1..4) -%}
                    {%- liquid
                      assign k = 'r' | append: i
                      assign kn = k | append: '_name'
                      assign kt = k | append: '_title'
                      assign kx = k | append: '_text'
                      assign ki = k | append: '_image'
                      assign rn = b[kn]
                      assign rt = b[kt]
                      assign rx = b[kx]
                      assign ri = b[ki]
                      assign ralt = 'Photo shared by ' | append: rn
                    -%}
                    {%- if rx != blank -%}
                      <div class="pgq-rv">
                        {%- if b.card_photos and ri != blank -%}{{ ri | image_url: width: 600 | image_tag: loading: 'lazy', alt: ralt }}{%- endif -%}
                        <div class="pgq-stars">★★★★★</div>
                        {%- if rt != blank -%}<h3>{{ rt }}</h3>{%- endif -%}
                        <p>{{ rx }}</p>
                        <small>— {{ rn }}{% if b.verified %} · Verified buyer{% endif %}</small>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
              <div class="pgq-rv-col">
                {%- if b.side_heading != blank -%}<h2>{{ b.side_heading }}</h2>{%- endif -%}
                {%- if b.rating != blank -%}<div class="pgq-badge">{{ b.rating }} <span>★★★★½</span></div>{%- endif -%}
                <div class="pgq-photos">
                  {%- for i in (1..9) -%}{%- assign kp = 'photo' | append: i -%}{%- assign ph = b[kp] -%}{%- if ph != blank -%}{{ ph | image_url: width: 500 | image_tag: loading: 'lazy', alt: ph.alt }}{%- endif -%}{%- endfor -%}
                </div>
              </div>
            </div>
            <div class="pgq-btns" style="justify-content:center">
              <button type="button" class="pgq-btn pgq-btn--go" data-pgq-next>{{ b.btn | default: 'Continue' }}</button>
            </div>
          </div>
        </section>

      {%- when 'question' -%}
        {%- assign q_count = q_count | plus: 1 -%}
        <section class="pgq-panel pgq-qpanel pgq-q-panel {{ bg }}" id="pgq-q{{ q_count }}-{{ sid }}" data-pgq-panel data-pgq-question {{ block.shopify_attributes }}>
          <div class="pgq-in pgq-q">
            <h2>{{ b.heading }}</h2>
            <div class="pgq-opts">
              {%- assign opts = b.options | newline_to_br | split: '<br />' -%}
              {%- for o in opts -%}{%- assign t = o | strip -%}{%- if t != blank -%}
                {%- if b.is_final -%}
                  <a class="pgq-opt" href="{{ product_url }}" data-pgq-answer="{{ t | escape }}">{{ t }}</a>
                {%- else -%}
                  <button type="button" class="pgq-opt" data-pgq-pick="{{ t | escape }}" aria-pressed="false">{{ t }}</button>
                {%- endif -%}
              {%- endif -%}{%- endfor -%}
            </div>
            {%- if b.note != blank -%}<p class="pgq-qnote">{{ b.note }}</p>{%- endif -%}
          </div>
        </section>
    {%- endcase -%}
  {%- endfor -%}

  <footer class="pgq-foot">
    <strong>This is an advertorial and not an actual news article, blog, or consumer protection update.</strong>
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    {{ section.settings.disclaimer }}
    <nav><a href="/policies/privacy-policy">Privacy Policy</a><a href="/policies/refund-policy">Returns Policy</a><a href="/pages/contact">Contact Us</a></nav>
  </footer>

  <div class="pgq-sticky" data-pgq-sticky hidden>
    <button type="button" class="pgq-btn pgq-btn--skip" data-pgq-sticky-skip>Skip</button>
    <button type="button" class="pgq-btn pgq-btn--go" data-pgq-sticky-next>Continue</button>
  </div>
</div>

<script>
(function () {
  function init(root) {
    root.querySelectorAll('[data-pgq]').forEach(function (wrap) {
      if (wrap.__pgq) return; wrap.__pgq = true;
      var panels = Array.prototype.slice.call(wrap.querySelectorAll('[data-pgq-panel]'));
      var firstQ = wrap.querySelector('[data-pgq-question]');
      var sticky = wrap.querySelector('[data-pgq-sticky]');
      var sNext = wrap.querySelector('[data-pgq-sticky-next]');
      var sSkip = wrap.querySelector('[data-pgq-sticky-skip]');
      var current = 0;
      function go(el) { if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      function next(i) { go(panels[i + 1]); }
      panels.forEach(function (p, i) {
        p.querySelectorAll('[data-pgq-next]').forEach(function (b) { b.addEventListener('click', function () { next(i); }); });
        p.querySelectorAll('[data-pgq-skip]').forEach(function (b) { b.addEventListener('click', function () { go(firstQ); }); });
        p.querySelectorAll('[data-pgq-pick]').forEach(function (b) {
          b.addEventListener('click', function () {
            p.querySelectorAll('[data-pgq-pick]').forEach(function (x) { x.setAttribute('aria-pressed', x === b); });
            try { sessionStorage.setItem('pgq_weight', b.getAttribute('data-pgq-pick')); } catch (e) {}
            setTimeout(function () { next(i); }, 150);
          });
        });
      });
      sNext.addEventListener('click', function () { next(current); });
      sSkip.addEventListener('click', function () { go(firstQ); });
      function update() {
        var mid = window.innerHeight * 0.45, idx = 0;
        panels.forEach(function (p, i) { if (p.getBoundingClientRect().top <= mid) idx = i; });
        current = idx;
        var p = panels[idx];
        var isQ = p.hasAttribute('data-pgq-question');
        var heroVisible = panels[0] && panels[0].getBoundingClientRect().bottom > window.innerHeight * 0.6;
        sticky.hidden = isQ || heroVisible;
        sNext.textContent = p.getAttribute('data-btn') || 'Continue';
        sSkip.style.display = p.getAttribute('data-skip') === 'true' ? '' : 'none';
      }
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(document); });
  else init(document);
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
</script>

